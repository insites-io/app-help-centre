{%- comment -%}
    A javascript is used to listen to the event for the input field of search.
    One is for the icon click of search, and other one is to trigger 
    the search on keypress enter(keyCode == 13).
{%- endcomment -%}
<div class="grid-container">
    <div class="spacer xxxx-large"></div>
    <div class="grid-x grid-padding-x centered">
        <div class="large-12 medium-12 small-12">
            <h2>How can we help?</h2>
            <div class="spacer xxx-large"></div>
        </div>
    </div>
    <div class="grid-x grid-padding-x">
        <div class="large-8 cell small-12 medium-10 large-offset-2 medium-offset-1">
            <ins-input
                id="search-input"
                class="large"
                placeholder="Search Help Centre"
                field="text"
                icon="icon-search"
                icon-event="true"
                error-message="Search Keyword cannot be blank">
            </ins-input>
        </div>
    </div>
    <div class="spacer xxxx-large"></div>
</div>

