---
metadata: {
  partial_name: "Footer"
}
---

<script>
const accordionItems = document.querySelectorAll('ins-accordion-item');
if (accordionItems.length > 0) {
  accordionItems.forEach(accordionItem => {    
    accordionItem.addEventListener('click', event => {
        const willShow = document.querySelector('.ins-accordion-item.open .ins-accordion-item_content.will-show');
        if (willShow) {
            willShow.style.maxHeight = 'initial';
        }
    });
  });
}
</script>

{%- parse_json filter -%}
    {
        "value_boolean": true,
        "name": "shown_in_footer_menu"
    }      
{%- endparse_json -%}
{%- graphql database_documentation = 'modules/help_centre/documentation/get_documentations' 
    properties: filter
-%}
{%- assign documentations = database_documentation.items.results -%}

<footer>
    <div class="footer-links">
        <hr>
        <div class="grid-container">
            <div class="spacer xxxx-large"></div>
            
            <div class="grid-x grid-padding-x">
                <div class="large-4 medium-12 small-12 cell">
                    <a href="/" aria-label="Homepage">
                    {% if context.exports.global.company_logo.url != blank %}
                        <img class="logo" src="{{ context.exports.global.company_logo.url }}" 
                        alt="{{ context.exports.global.company_slogan | default: 'Homepage' }}" width="180" height="90">
                    {% else %}
                        <img class="logo" src="{{ 'modules/help_centre/images/logo/Logo@2x.png' | asset_url }}" 
                        alt="Homepage" width="180" height="90">
                    {% endif %}     
                    </a>
                    <div class="spacer large show-for-medium-only"></div>

                </div>

                <div class="large-4 medium-12 small-12 cell">
                    <h4>Documentation</h4>
                    <div class="spacer medium"></div>
                    
                        {%- for documentation in documentations -%}
                            {%- if documentation.parent_category == null -%}
                               
                                    <ul>
                                        <li>
                                            <a href="/documentation/{{- documentation.slug -}}">{{ documentation.title }}</a>
                                            {% if forloop.last == false %}
                                            <div class="spacer small"></div>
                                            {%- endif -%}
                                        </li>
                                        {%- for child_category in documentations -%}
                                            {%- if child_category.parent_category == documentation.title -%}
                                            <ul>
                                                <li>
                                                    <a href="/documentation/{{- child_category.slug -}}">{{- child_category.title -}}</a>
                                                    {% if forloop.last == false %}
                                                    <div class="spacer small"></div>
                                                    {%- endif -%}
                                                </li>
                                            </ul>
                                            {%- endif -%}
                                        {%- endfor -%}
                                    </ul>
                               
                            {%- endif -%}
                        {%- endfor -%}
                    
                    <div class="spacer large show-for-medium-only"></div>
                </div>

                <div class="large-4 medium-12 small-12 cell">
                    <div class="grid-x">
                        <div class="large-6 medium-6 small-12 cell">
                            <h4>Links</h4>
                            <div class="spacer medium"></div>
                            <ul>
                                <li>
                                    <a href="/faqs">FAQs</a>
                                    <div class="spacer small"></div>
                                </li>
                                <li>
                                    <a href="/articles">Articles</a>
                                    <div class="spacer small"></div>
                                </li>
                                <li>
                                    <a href="/timeline">Timeline</a>
                                    <div class="spacer small"></div>
                                </li>
                                <li>
                                    <a href="/contact-us">Contact Us</a>
                                    <div class="spacer small"></div>
                                </li>
                            </ul>
                        </div>
                        <div class="large-6 medium-6 small-12 cell">
                            <h4>Discover</h4>
                            <div class="spacer medium"></div>
                            <ul>
                                <li>
                                    <a href="/" target="_blank">Website &nbsp;<span class="icon-external-link"></span></a>
                                    <div class="spacer small"></div>
                                </li>
                                <li>
                                    <a href="/" target="_blank">Community &nbsp;<span class="icon-external-link"></span></a>
                                    <div class="spacer small"></div>
                                </li>
                                <li>
                                    <a href="/" target="_blank">Roadmap &nbsp;<span class="icon-external-link"></span></a>
                                    <div class="spacer small"></div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="spacer xxxx-large"></div>
    </div>

    <div class="footer">
        <div class="grid-container">
            <div class="grid-x grid-padding-x">
                <div class="small-12 large-8 medium-8 cell">
                    <a href="http://example.com" target="_blank" class="footer-link">
                        ABN 12 345 678 910
                    </a>
                    <a href="/privacy-policy" class="footer-link">
                        Privacy Policy
                    </a>
                    <a href="/terms-and-conditions" class="footer-link">
                        Terms and Conditions
                    </a>
                </div>
                <div class="small-12 large-4 medium-4 cell text-right">
                    <span class="copyright">Copyright © {{ "now" | date: "%Y" }}. Powered by <a href="https://www.insites.io/" target="_blank">Insites</a>.</span>
                </div>
            </div>
        </div>
    </div>

</footer>