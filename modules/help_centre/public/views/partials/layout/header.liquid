---
metadata: {
  partial_name: "Header"
}
---

<header class="header">
    <div class="top-bar grid-container">
        <div class="top-bar-left">
            <a href="/" aria-label="Homepage">
            {% if context.exports.global.company_logo.url != blank %}
                <img class="logo" src="{{ context.exports.global.company_logo.url }}" 
                alt="{{ context.exports.global.company_slogan | default: 'Homepage' }}" width="180" height="90">
            {% else %}
                <img class="logo" src="{{ 'modules/help_centre/images/logo/Logo@2x.png' | asset_url }}" 
                alt="Homepage" width="180" height="90">
            {% endif %}     
            </a>
        </div>
        <div class="top-bar-right">
            <div class="show-for-large">
		    	{% include 'modules/help_centre/layout/menu_items' %}
            </div>
            <div class="hide-for-large mobile-menu-toggle">
                <div id="mobile-menu-btn" class="icon-menu-1"></div>
				<ins-drawer no-padding
				 	backdrop-can-close="false"
					id="mobile-menu" 
					show-header=false
					position="right">
					<div>
		    			{% include 'modules/help_centre/layout/menu_items' %}
					</div>
				</ins-drawer>
            </div>
        </div>
    </div>
</header>