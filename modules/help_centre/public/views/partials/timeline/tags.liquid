---
metadata: {
  partial_name: "Timeline Tags"
}
---
{%- graphql tags = 'modules/help_centre/tags/get_tags' | dig: 'items','results' -%}

{%- if tag_ids != blank -%}
    {%- for tag_id in tag_ids -%}

        {% assign props = tags | array_detect: id: tag_id  %}

        {% if props %}
        <ins-tag label="{{- props.name -}}"
            icon="{{- props.icon -}}" 
            color="{{- props.color -}}">
        </ins-tag>
        {% endif %}

    {%- endfor -%}
{%- endif -%}