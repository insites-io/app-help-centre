---
metadata: {
  partial_name: "Timeline Filters"
}
---

{%- assign date_from = "" -%}
{%- assign date_to = "" -%}
{%- assign period = context.params.period | default: "" -%}
{%- assign range = context.params.range | default: "" -%}

{%- if range != "" and range != "All" -%}
    {%- assign dates = range | split: ',' -%}
    {%- if dates.size == 2 -%}
        {%- assign date_from = dates[0] -%}
        {%- assign date_to = dates[1] -%}

        {%- assign range = '{}' | parse_json -%}
        {%- assign range = range | add_hash_key: "gte", date_from -%}
        {%- assign range = range | add_hash_key: "lte", date_to -%}
    {%- endif -%}

{%- else -%}
    {%- assign date_today = "now" | date: "%Y-%m-%d" -%}
    {%- assign range = '{}' | parse_json -%}
    {%- assign range = range | add_hash_key: "lte", date_today -%}
{%- endif -%}

{%- export range, namespace: 'filters' -%}

<div class="grid-x grid-padding-x">
    <div class="small-12 medium-10 large-8 large-offset-2 medium-offset-1 cell">
        <ins-filter id="timelineFilter" label="Filters:" with-date-filter date-title="Date Period"
            date-from="{{ date_from }}" 
            date-to="{{ date_to }}" 
            default-date="{{ period }}">

            {% include 'modules/ins_template_help_centre/timeline/filter_category' %}
            {% include 'modules/ins_template_help_centre/timeline/filter_tags' %}
        </ins-filter>
    </div>
</div>