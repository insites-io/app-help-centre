---
metadata: {
  partial_name: "Category Sidebar"
}
---

{%- graphql database = 'modules/help_centre/system/get_database' 
    database_name: database_name
-%}
{%- assign properties = database.items.results[0].properties -%}
{%- assign categories = '[]' | parse_json -%}
{%- for property in properties -%}
	{%- if property.name == "category" -%}
		{%- assign categories = property.metadata.options -%}
        {%- assign categories_property = property -%}
  	{%- endif -%}
{%- endfor -%}

<div class="layout-category-sidebar">
    <h4>Categories</h4>
    <div class="spacer large"></div>
    {%- assign params = '[]' | parse_json -%}
    {%- for item in context.params -%}
        {%- assign params = params | add_to_array: item[0] -%}
    {%- endfor -%}
    
    <ins-accordion-link
        link-target="_self" 
        link="/{{ all_link }}"
        label="All"
        {% if params contains "category" %}
        {% else %}
        active
        {% endif %}>
    </ins-accordion-link>

    {%- for category in categories -%}
        <ins-accordion-link
            link-target="_self"
            link="?category={{ category }}"
            label="{{ category }}"
            {% if params contains "category" and context.params.category == category %}
            active
            {% endif %}>
        </ins-accordion-link>
    {%- endfor -%}
</div>