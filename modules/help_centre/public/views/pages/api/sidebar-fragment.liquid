---
slug: api/fragments/sidebar
layout_name: ''
metadata: {
    "page_name": "Sidebar",
    "page_title": "Sidebar"
}
response_headers: >
  {
    "Content-Type": "text/html"
  }
dynamic_cache:
  layout: true
  key: >
    {%- assign title = context.params.title | default: '' -%}
    {%- assign schema_name = title | downcase | replace: " ", "_" -%}
    {%- assign table = 'modules/help_centre/' | append: schema_name -%}
    {%- graphql res = 'modules/help_centre/sidebar/get_latest', table: table -%}
    {%- assign record = res.items.results.first -%}
    {{ 'sidebar_cached_' | append: record.updated_at }}
    {%- parse_json models -%}
    [
      "modules/help_centre/documentation"
    ]
    {%- endparse_json -%}
    {%- include "modules/help_centre/generate_cache_key", models: models -%}
---
{%- assign title = context.params.title | default: '' -%}
{%- assign current_slug = context.params.current_slug | default: '' -%}
{%- assign parent_slug = context.params.parent_slug | default: '' -%}

{%- include 'modules/help_centre/content/sidebar/documentation_sidebar', 
    title: title,
    parent_slug: parent_slug,
    current_slug: current_slug -%}