layout: modules/help_centre/default_layout
searchable: true
max_deep_level: 1
metadata: {
    "page_name": "Contact Us",
    "page_title": "Contact Us",
    "meta_title": "Contact Us",
    "canonical_url": "",
    "open_graph_url": "",
    "open_graph_type": "",
    "meta_description": "Contact Us",
    "open_graph_title": "Contact Us",
    "open_graph_site_name": "Insites Help Centre",
    "open_graph_description": "Contact Us",
    "search_engine_visibility": "true"
}
#Do not use dynamic_cache on page that has a form
---

{%- assign breadcrumb = '' | split: "|" -%}
{%- parse_json 'breadcrumb_item' -%}
{ "label": "Contact Us", "link": "/contact-us" }
{%- endparse_json -%}
{%- assign breadcrumb = breadcrumb | add_to_array: breadcrumb_item -%}

{%- include 'modules/help_centre/content/homepage_banner', 
  title: "Contact Us" -%}

<div class="sub-header"> 
    <div class="grid-container">
        <div class="spacer small"></div>
        <div class="grid-x grid-padding-x">
            <div class="layout-breadcrumbs large-9 medium-7 small-12 large-order-1 medium-order-1 small-order-2 cell">
                <a class="color-font-head" href="/">Help Centre</a>
                <span class="icon-chevron-right"></span>
                {%- for item in breadcrumb -%}
                    {%- if forloop.last != true -%}
                        <a class="color-font-head" href="{{ item.link }}">{{ item.label }}</a>
                        <span class="icon-chevron-right"></span>
                    {%- else -%}
                        <span class="current">{{ item.label }}</span>
                    {%- endif -%}
                {%- endfor -%}
            </div>
            <div class="large-3 medium-5 small-12 large-order-2 medium-order-2 small-order-1 cell">
                <ins-input
                    id="search-input"
                    placeholder="What are you looking for?"
                    field="text"
                    icon="icon-search"
                    error-message="Search Keyword cannot be blank"
                    icon-event="true">
                </ins-input>
                <div class="spacer medium show-for-small-only"></div>
            </div>
        </div>
        <div class="spacer small"></div>
    </div>
</div>



<div class="contact-us grid-container">
  <div class="spacer xxxx-large"></div>
  <div class="grid-x grid-padding-x align-center">
    <div class="large-7 medium-11 small-12 cell">
	    <h1 class="">Send Us a Message</h1>
    </div>
    <div class="small-12 cell spacer medium"></div>
    <div class="large-7 medium-11 small-12 cell">
      <p>
        Haven't found the answer you were looking for? <br>
        Send us a message, and we will get back to you as soon as possible. Our usual response time is 1-2 business days.
      </p>
    </div>
  </div>
  <div class="spacer xx-large"></div>
  <div class="grid-x grid-padding-x align-center">
    <div class="large-7 medium-11 small-12 cell">
    <link href="https://components.insites.io/v2/latest/css/insites-font-icons.css" rel="stylesheet" >

<script type="module" src="https://components.insites.io/v2/latest/insites.esm.js"></script>
<script nomodule src="https://components.insites.io/v2/latest/insites.js"></script>

      {%- include_form 'modules/ins_forms/contact_us' -%}
    </div>
  </div>
  <div class="spacer xxxx-large"></div>
</div>

 
 <script src="{{ 'modules/help_centre/scripts/contact_us.js' | asset_url }}"></script>