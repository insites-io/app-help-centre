{%- comment -%} Tags {%- endcomment -%}
{%- assign names = "New,Improvement,Bugfix" | split: ',' -%}
{%- assign color = "" -%}
{%- assign icon = "" -%}

{%- for name in names -%}
    {%- if name == "New" -%}
        {%- assign color = "green" -%}
    {%- elsif name == "Improvement" -%}
        {%- assign color = "orange" -%}
    {%- else -%}
        {%- assign color = "red" -%}
    {%- endif -%}
    {%- graphql create_tag_entry = "modules/help_centre/tags/create_tag", 
        name: name, 
        color: color,
        icon: icon
    -%}
{%- endfor -%}
{% log results, type: "SEED DATA: Tags" %}
{%- comment -%} Tags {%- endcomment -%}


