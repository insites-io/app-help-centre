---
metadata: {
  partial_name: "Article Details"
}
---

{%- assign last_updated = item.updated_at -%}
{%- comment -%} Checking if detail can be display  {%- endcomment -%}
{%- assign date_now = 'today' | to_time -%}
{%- assign item_status = item.status | downcase -%}
{%- assign is_displayed = false -%}

{%- if item_status == 'published' and date_now >= item.publish_date -%}
	{%- assign is_displayed = true -%}
{%- elsif item_status == 'published' and context.params.preview == "true" -%}
	{%- assign is_displayed = true -%}
{%- elsif item_status == 'draft' and context.params.preview == "true" -%}
	{%- assign is_displayed = true -%}
{%- endif -%}
{%- comment -%} Checking if detail can be display  {%- endcomment -%}

{%- if is_displayed -%}
	<div class="articles grid-container">
		<div class="spacer xxxx-large"></div>
		<div class="grid-x grid-padding-x">
			<div class="small-12 medium-12 large-8 large-offset-2 cell text-center">
				<span class="category">{{ item.category | upcase }}</span>
				<div class="spacer medium"></div>

				<h1>{{ item.post_title }}</h1>
				<div class="spacer small"></div>

				<span class="published-on">
				  Published on {{ item.publish_date  | date: "%B %d, %Y" }}
				  {%- if last_updated contains item.publish_date -%}
					
				  {%- else -%}
					, updated on {{ last_updated | date: "%B %d, %Y" }}
				  {%- endif -%}
				</span>
				<div class="spacer xxxx-large"></div>
			</div>
		</div>
		<div class="grid-x">
			<div class="small-12 medium-12 large-8 large-offset-2 cell">
				{{ item.content | html_safe }}
			</div>
		</div>
		
		<div class="spacer xxxx-large"></div>
	</div>
{%- else -%}
	{% redirect_to '/404' %}
{%- endif -%}