{%- comment -%}
- Creates INS CRM Contact record on form submit.
- Assigns form data w/ the user_id from above.
Accept Parameters:
    model_id: ID! -> model ID to update once CRM record is processed
    email: STRING! -> search if user exist
    first_name: STRING (optional)
    last_name: String (optional)
{%- endcomment -%}
{% comment %}STEP 1: Check if CRM record already exist. {% endcomment %}
{%- graphql user = 'modules/ins_template_help_centre/system/get_user_id_by_email', 
    email: email -%}
    {%- if context.environment == "staging" -%}
        {%- log user -%}
    {%- endif -%}
    {%- if user.items.total_entries == 1 -%}
    {% comment %}IF exist, use that user_id {% endcomment %}
        {%- assign user_id = user.items.results[0].id -%}
        {%- if context.environment == "staging" -%}
            {%- log user, type: "CRM record already exist." -%}
        {%- endif -%}
    {%- else -%}
    {% comment %}ELSE create a CRM record{% endcomment %}
        {%- if context.environment == "staging" -%}
            {%- log "No CRM record found, needs to be created" -%}
        {%- endif -%}
        {%- graphql user = 'modules/ins_template_help_centre/system/create_crm_contact', 
            email: email, 
            first_name: first_name, 
            last_name: last_name,
            mobile_phone_country_code: mobile_phone_country_code
            mobile_phone_number: mobile_phone -%}
        {% comment %}Use created record for user_id {% endcomment %}
        {%- assign user_id = user.items.id -%}
        {%- if context.environment == "staging" -%}
            {%- log user, type: "New CRM record created" -%}
        {%- endif -%}
    {%- endif -%}
{%- comment -%}STEP 2: Update form submission, assign 'user_id' {%- endcomment -%}
{%- graphql updated_form = 'modules/ins_template_help_centre/system/update_model_user_id', 
    id: model_id, 
    user_id: user_id -%}
{% export user_id %}
{%- if context.environment == "staging" -%}
    {%- log updated_form, type: "Form submission has been updated w/ user_id." -%}
{%- endif -%}