---
metadata: {
  "database_name": "modules/ins_template_help_centre/timeline",
  "slug2": "{{ item.slug }}",
  "layout": "details",
  "page_title": "{{ item.title }}",
  "meta_title": "{{ item.meta_title }}",
  "meta_description": "{{ item.meta_description }}",
  "og:title": "{{ item.og_type }}",
  "og:description": "{{ item.og_description }}",
  "og:type": "{{ item.og_type }}",
  "og:url": "{{ item.og_url }}",
  "og:site_name": "{{ item.og_site_name }}",
  "og:image": '{{ item.og_image.version["OG-Image-1200x630"] }}',
  "canonical_url": "{{ item.canonical_url }}",
  "search_engine_visibility": true
}
---

{%- assign last_updated = context.exports.data.updated_at -%}

{%- comment -%} Checking if detail can be display  {%- endcomment -%}
{%- assign date_now = 'today' | to_time -%}
{%- assign item_status = item.status | downcase -%}
{%- assign is_displayed = false -%}

{%- if item_status == 'published' and item.release_date <= date_now and item.enable_details_page -%}
	{%- assign is_displayed = true -%}
{%- elsif item_status == 'published' and item.release_date > date_now  and context.params.preview == "true" and item.enable_details_page -%}
	{%- assign is_displayed = true -%}
{%- elsif item_status == 'draft' and context.params.preview == "true" and item.enable_details_page -%}
	{%- assign is_displayed = true -%}
{%- endif -%}
{%- comment -%} Checking if detail can be display  {%- endcomment -%}

{%- if is_displayed -%}
	<div class="articles grid-container">
		<div class="spacer xxxx-large"></div>
		<div class="grid-x grid-padding-x">
			<div class="small-12 medium-12 large-8 large-offset-2 cell text-center">
				{%- include "modules/ins_template_help_centre/timeline/tags", tag_ids: item.tags -%}
				<div class="spacer medium"></div>

				<h1>{{ item.title }}</h1>
				<div class="spacer small"></div>
				<span class="published-on">
					Published on {{ item.release_date  | date: "%B %d, %Y" }}
					
					{%- if last_updated contains item.release_date -%}
						
					{%- else -%}
						, updated on {{ last_updated | date: "%B %d, %Y" }}
					{%- endif -%}
				</span>
				<div class="spacer xxxx-large"></div>
			</div>
			<div class="grid-x">
				<div class="small-12 medium-12 large-8 large-offset-2 cell">
					{{- item.detailed_content | markdown -}}
				</div>
			</div>
			
		</div>
		<div class="spacer xxxx-large"></div>
	</div>
{%- else -%}
	{% redirect_to '/404' %}
{%- endif -%}