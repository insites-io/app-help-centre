---
metadata: {
  partial_name: "Timeline Tags"
}
---

{%- if tag_ids != blank -%}
    {%- for tag_id in tag_ids -%}
        {%- graphql tag = 'modules/ins_template_help_centre/tags/get_tag_by_id', id: tag_id -%}
        {%- if tag.items.total_entries > 0 -%}

            {%- assign props = tag.items.results[0].properties -%}

            <ins-tag label="{{- props.name -}}"
                icon="{{- props.icon -}}" 
                color="{{- props.color -}}">
            </ins-tag>

        {%- endif -%}
    {%- endfor -%}
{%- endif -%}