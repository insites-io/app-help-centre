---
name: subscribe
resource: modules/ins_template_help_centre/subscriptions
resource_owner: anyone
redirect_to: /subscribe-success
fields:
    properties:
        email:
            validation:
                email: 
                    message: Please use a valid email address
                presence: 
                    message: Please use a valid email address
callback_actions: >
    {%- include 'modules/insites_core/insites_admin/insites_create_crm_on_submit',
        email: form.properties.email
        model_id: form.id -%}
email_notifications:
    - modules/ins_template_help_centre/subscribe_email
    - modules/insites_core/insites_internal_email
#api_call_notifications:
#    - modules/insites_core/insites_create_crm_activity
---

{%- include 'modules/ins_template_help_centre/system/global_content' -%}

<div class="subscribe" id="newsletter">
    <div class="grid-container">
        <div class="grid-x">
            <div class="large-12 medium-12 small-12 cell">
                <div class="spacer xxxx-large"></div>
                <h2 class="centered">Stay up to date with Insites</h2>
                <div class="spacer small"></div>
            </div>

            <div class="large-12 medium-12 small-12 cell">
                <p class="centered">Subscribe to our newsletter for the latest news and product updates straight to your inbox.</p>
                <div class="spacer large"></div>
            </div>

            
            {%- form 
                html-id: "subscribe-form"
                html-onSubmit: "return App.validation.validateSubscriptionForm(event)"
                html-novalidate: true -%}

                <div class="large-12 medium-12 small-12 cell grid-x grid-padding-x">
                    <div class="large-7 medium-7 small-12 large-offset-2 medium-offset-1 cell">
                        <ins-input validate
                            id="subscribe-input"
                            field="email"
                            class="auto cell subscribe-component"
                            name="{{ form.fields.properties.email.name }}"
                            placeholder="Enter email address" 
                            error-message="{{ form.fields.properties.email.validation.rules.email.message }}">
                        </ins-input>
                    </div>
                    <div class="large-3 medium-4 small-12 cell">
                        <ins-button 
                            id="subscribe-button"
                            label="Subscribe"
                            size="large"
                            solid
                            color="blue">
                        </ins-button>
                        <div class="spacer xxxx-large"></div>
                    </div>
                </div>

            {%- endform -%}

        </div>
    </div>
</div>

