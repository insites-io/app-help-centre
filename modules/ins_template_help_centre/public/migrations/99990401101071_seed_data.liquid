{%- comment -%} FAQS {%- endcomment -%}
{%- assign question = "This is sample question " -%}
{%- assign answer = "Lorem ipsum dolor sit amet consectetur adipisicing elit.
    Consequatur voluptatem pariatur inventore incidunt, 
    doloremque libero officia debitis dignissimos porro qui numquam placeat similique, 
    dolores aliquam ullam provident eveniet voluptates cupiditate." 
-%}
{%- assign featured = true -%}
{%- assign faq_sort_order = "" -%}

{%- for i in (1..3) -%}
    {%- assign question_appended = question | append: i -%}
    {%- assign faq_sort_order = i -%}
    {%- graphql create_faq_entry = "modules/ins_template_help_centre/faqs/create_faq" 
        question: question_appended,
        answer: answer,
        featured: featured, 
        sort_order: faq_sort_order
    -%}
{%- endfor -%}

{%- comment -%} Articles {%- endcomment -%}
{%- assign publish_date = "now" | date: "%Y-%m-%d" -%}
{%- assign short_text = "This is sample article " -%}
{%- assign post_title = "This is sample Article " -%}
{%- assign content = "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>" -%}
{%- assign slug = "this-is-sample-article-" -%}
{%- assign sort_order = "" -%}

{%- for i in (1..3) -%}
    {%- assign short_text_appended = short_text | append: i -%}
    {%- assign post_title_appended = post_title | append: i -%}
    {%- assign slug_appended = slug | append: i -%}
    {%- assign sort_order = i -%}
    {%- graphql create_article_entry = "modules/ins_template_help_centre/articles/create_article", 
        publish_date: publish_date, 
        short_text: short_text_appended, 
        post_title: post_title_appended,
        content: content, 
        slug: slug_appended, 
        sort_order: sort_order, 
        status: status
    -%}
{%- endfor -%}

{%- comment -%} Useful Link {%- endcomment -%}
{%- assign labels = "Sales Brochure, Support Packages, Platform Flyer" | split: ',' -%}
{%- for label in labels -%}
    {%- graphql create_article_entry = "modules/ins_template_help_centre/useful_links/create_useful_link", 
        label: label, sort_order: label.index
    -%}
{%- endfor -%}

{%- comment -%} Timeline {%- endcomment -%}
{%- assign timeline_slug = "this-is-sample-timeline-" -%}
{%- assign tag = "New" -%}
{%- assign timeline_title = "This is sample Timeline " -%}
{%- assign release_date = "now" | date: "%Y-%m-%d" -%}
{%- assign timeline_content = "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>" -%}
{%- assign detailed_content = "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>" -%}
{%- assign timeline_author = "Admin" -%}
