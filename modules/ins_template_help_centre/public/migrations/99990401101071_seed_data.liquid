{%- assign category = "" -%}

{%- for i in (1..3) -%}
    {%- assign slug_appended = timeline_slug | append: i -%}
    {%- assign title_appended = timeline_title | append: i -%}
    {%- graphql create_timeline_entry = "modules/ins_template_help_centre/timeline/create_timeline", 
        slug: slug_appended, 
        tag: tag, 
        title: title_appended,
        release_date: release_date, 
        timeline_content: timeline_content, 
        detailed_content: detailed_content, 
        author: timeline_author,
        enable_details_page: enable_details_page,
        status: timeline_status,
        parent: parent,
        category: category
    -%}
{%- endfor -%}

{%- comment -%} Documentation {%- endcomment -%}
{%- assign documentation_slug = "sample-documentation-" -%}
{%- assign documentation_title = "Sample Documentation " -%}
{%- assign documentation_author = "Admin" -%}
{%- assign publish_date = "now" | date: "%Y-%m-%d" -%}
{%- assign short_description = "Short Description for Documentation " -%}
{%- assign content = "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>" -%}
{%- assign documentation_status = "Published" -%}
{%- assign order = "" -%}
{%- assign menu_label = "DC-" -%}
{%- assign parent_category = "" -%}
{%- assign section = "Templates" -%}
{%- assign shown_in_sidebar_menu = true -%}
{%- assign shown_in_footer_menu = true -%}


{%- for i in (1..3) -%}
    {%- assign document_slug_appended = documentation_slug | append: i -%}
    {%- assign document_title_appended = documentation_title | append: i -%}
    {%- assign document_short_description_appended = short_description | append: i -%}
    {%- assign document_menu_label_appended = menu_label | append: i -%}
    {%- assign order = i -%}
    
    {%- graphql create_documentation_entry = "modules/ins_template_help_centre/documentation/create_documentation", 
        slug: document_slug_appended,
        title: document_title_appended,
        author: documentation_author,
        publish_date: publish_date,
        short_description: document_short_description_appended,
        content: content,
        status: documentation_status,
        order: order,
        menu_label: document_menu_label_appended,
        parent_category: parent_category,
        section: section,
        shown_in_sidebar_menu: shown_in_sidebar_menu,
        shown_in_footer_menu: shown_in_footer_menu
    -%}
{%- endfor -%}


{%- comment -%} Tags {%- endcomment -%}
{%- assign names = "New,Improvement,Bugfix" | split: ',' -%}
{%- assign color = "" -%}
{%- assign icon = "" -%}

{%- for name in names -%}
    {%- if name == "New" -%}
        {%- assign color = "green" -%}
    {%- elsif name == "Improvement" -%}
        {%- assign color = "orange" -%}
    {%- else -%}
        {%- assign color = "red" -%}
    {%- endif -%}
    {%- graphql create_tag_entry = "modules/ins_template_help_centre/tags/create_tag", 
        name: name, 
        color: color,
        icon: icon
    -%}
{%- endfor -%}